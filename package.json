{
  "name": "pns-erp",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "deploy": "bash scripts/deploy.sh all",
    "deploy:frontend": "bash scripts/deploy.sh frontend",
    "deploy:backend": "bash scripts/deploy.sh backend",
    "db:backup": "bash scripts/db-backup.sh",
    "db:backup:push": "bash scripts/db-backup-push.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:export:sheets": "npm run export:sheets -w backend",
    "demo:purchase-sales-gst": "node scripts/demo-purchase-sales-gst.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.52.0"
  }
}
