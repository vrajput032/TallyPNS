DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Required for `npm run seed -w backend` (min 8 chars; do not commit real values)
ADMIN_SEED_PASSWORD=""
# Staff user (add-only). Required for `npm run seed -w backend`
GARVIT_SEED_PASSWORD=""
# Optional: comma-separated browser origins (production default: https://tallypns.pages.dev)
CORS_ORIGINS=""
NODE_ENV=development
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
# Optional but preferred for Storage uploads (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=""
PORT=4000
DELETE_PIN="940400"
RENDER_DEPLOY_HOOK_URL="https://api.render.com/deploy/srv-xxxx?key=yyyy"
# Optional: for `npm run render:sync-slack-env` (Dashboard → Account Settings → API Keys)
RENDER_API_KEY=""
# Slack Quick Bill bot (optional)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# Comma-separated Slack member IDs allowed to run /bill (Profile → ⋮ → Copy member ID)
SLACK_ALLOWED_USER_IDS=""
FRONTEND_URL="https://tallypns.pages.dev"
# Google Sheets live backup (optional). Share the sheet with the service account as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID="1JodzZIfLaQktBO0P9bAsMxtpZ9Fwuivc-lUrIFyyhJE"
GOOGLE_SERVICE_ACCOUNT_EMAIL="pns-sheets@YOUR_PROJECT.iam.gserviceaccount.com"
# Paste private_key from the JSON key; keep \n escaped as \\n in .env
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: for external cron → POST /api/sheets/cron with header X-Sheets-Cron-Secret
GOOGLE_SHEETS_CRON_SECRET=""
