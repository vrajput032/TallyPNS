generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesInvoices  SalesInvoice[]
  receipts       PaymentReceipt[]
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseBills  PurchaseBill[]
  payments       VendorPayment[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  hsn           String?
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  unit          String   @default("PCS")
  price         Decimal  @default(0) @db.Decimal(14, 2)
  openingStock  Decimal  @default(0) @db.Decimal(14, 2)
  currentStock  Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesInvoiceItems    SalesInvoiceItem[]
  purchaseBillItems    PurchaseBillItem[]
  stockMovements       StockMovement[]
  sizeStocks           ProductSizeStock[]
}

model ProductSizeStock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeMm    Decimal @db.Decimal(10, 2)
  quantity  Decimal @default(0) @db.Decimal(14, 2)

  @@unique([productId, sizeMm])
  @@index([sizeMm])
}

model SalesInvoice {
  id           String   @id @default(cuid())
  invoiceNo    String   @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  invoiceDate  DateTime @default(now())
  transport    String?
  vehicleNo    String?
  totalAmount  Decimal   @default(0) @db.Decimal(14, 2)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        SalesInvoiceItem[]
  receipts     PaymentReceipt[]

  @@index([deletedAt])
}

model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  /** Null for manual/non-stock lines (scraps, construction, electricity, etc.) */
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  /** Free-text description for manual lines; unused when productId is set */
  description    String?
  /** Optional HSN/SAC for manual lines (print + GSTR-1) */
  hsn            String?
  /** Unit for manual lines (e.g. NOS, LOT, KWH); unused when productId is set */
  unit           String?
  /** Optional pipe/material size in mm (e.g. 95) — catalog sales only */
  sizeMm         Decimal?     @db.Decimal(10, 2)
  quantity       Decimal      @db.Decimal(14, 2)
  rate           Decimal      @db.Decimal(14, 2)
  gstRate        Decimal      @db.Decimal(5, 2)
  amount         Decimal      @db.Decimal(14, 2)
}

model PurchaseBill {
  id          String   @id @default(cuid())
  billNo      String   @unique
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  billDate    DateTime @default(now())
  transport   String?
  vehicleNo   String?
  totalAmount Decimal   @default(0) @db.Decimal(14, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       PurchaseBillItem[]
  payments    VendorPayment[]

  @@index([deletedAt])
}

model PurchaseBillItem {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Decimal      @db.Decimal(14, 3) // Tons (or product unit qty)
  pricePerKg     Decimal?     @db.Decimal(14, 4)
  rate           Decimal      @db.Decimal(14, 2) // ₹ per Ton (or per unit)
  gstRate        Decimal      @db.Decimal(5, 2)
  amount         Decimal      @db.Decimal(14, 2)
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Decimal           @db.Decimal(14, 2)
  sizeMm    Decimal?          @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime          @default(now())
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum PaymentMode {
  CASH
  BANK
}

/** Money received from customer against a sales invoice */
model PaymentReceipt {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  salesInvoiceId String
  salesInvoice   SalesInvoice  @relation(fields: [salesInvoiceId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  mode           PaymentMode
  reference      String?
  receiptDate    DateTime      @default(now())
  narration      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([receiptDate])
  @@index([mode])
}

/** Money paid to vendor against a purchase bill */
model VendorPayment {
  id             String       @id @default(cuid())
  paymentNo      String       @unique
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  mode           PaymentMode
  reference      String?
  paymentDate    DateTime     @default(now())
  narration      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([purchaseBillId])
  @@index([vendorId])
  @@index([paymentDate])
  @@index([mode])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  accountName String
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(14, 2)
  narration   String?
  entryDate   DateTime        @default(now())
  createdAt   DateTime        @default(now())
}

/** Supplier steel / MS tube bills (kg in, yield to pipe pieces). Separate from catalog PurchaseBill. */
model RawMaterialBill {
  id             String    @id @default(cuid())
  billNo         String    @unique
  supplierName   String
  supplierGstin  String?
  billDate       DateTime  @default(now())
  vehicleNo      String?
  destination    String?
  taxableAmount  Decimal   @default(0) @db.Decimal(14, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal   @default(0) @db.Decimal(14, 2)
  roundOff       Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal   @default(0) @db.Decimal(14, 2)
  totalKg        Decimal   @default(0) @db.Decimal(14, 3)
  notes          String?
  sourceFileName String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items    RawMaterialBillItem[]
  payments RawMaterialPayment[]

  @@index([deletedAt])
  @@index([billDate])
  @@index([supplierName])
}

model RawMaterialBillItem {
  id          String          @id @default(cuid())
  billId      String
  bill        RawMaterialBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  hsn         String?
  quantityKg  Decimal         @db.Decimal(14, 3)
  ratePerKg   Decimal         @db.Decimal(14, 4)
  amount      Decimal         @db.Decimal(14, 2)
}

model RawMaterialPayment {
  id          String          @id @default(cuid())
  paymentNo   String          @unique
  billId      String
  bill        RawMaterialBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(14, 2)
  mode        PaymentMode
  reference   String?
  paymentDate DateTime        @default(now())
  narration   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([billId])
  @@index([paymentDate])
  @@index([mode])
}
